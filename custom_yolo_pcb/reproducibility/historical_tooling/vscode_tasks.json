{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify reproducibility package",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\verify_package.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Train original then Selected Enhanced YOLOv8n",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_local_vscode_comparison.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Resume enhanced-model same run only",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_local_vscode_comparison.ps1",
        "-OutputDir",
        "${input:comparisonOutputDir}",
        "-ResumeEnhancedOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ],
  "inputs": [
    {
      "id": "comparisonOutputDir",
      "type": "promptString",
      "description": "Existing failed comparison output directory",
      "default": "results\\local_vscode_comparison"
    }
  ]
}
